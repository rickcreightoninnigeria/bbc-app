{
  "expo": {
    "name": "BBC",
    "slug": "BBC",
    "scheme": "bbcapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bereanbiblechurch.app"
    },
    "android": {
      "package": "com.bereanbiblechurch.app",
      "adaptiveIcon": {
        "backgroundColor": "#473483",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#473483",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ],
      "expo-notifications",
      "expo-web-browser"
    ]
  }
}
